<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>List View Replica</masterLabel>
    <description>Replicates the list view experience for use in CRMA</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__FlowScreen</target>
        <target>analytics__Dashboard</target>
        <target>analytics__Lens</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="objectApiName" type="String" label="Object API Name" required="true"/>
            <property name="listViewId" type="String" label="List View ID" required="true"/>
        </targetConfig>
        <targetConfig targets="lightning__FlowScreen">
            <property name="objectApiName" type="String" label="Object API Name" required="true"/>
            <property name="listViewId" type="String" label="List View ID" required="true"/>
            <property name="recordId" type="String" label="Record ID" required="false"/>
            <property name="filterField" type="String" label="Filter Field API Name" required="false"/>
            <property name="filterValue" type="String" label="Filter Field Value" required="false"/>
        </targetConfig>
        <targetConfig targets="analytics__Dashboard,analytics__Lens">
            <property name="objectApiName" type="String" label="Object API Name" required="true"/>
            <property name="listViewId" type="String" label="List View ID" required="true"/>
            <property name="recordId" type="String" label="Record ID" required="false"/>
            <property name="filterField" type="String" label="Filter Field API Name" required="false"/>
            <property name="filterValue" type="String" label="Filter Field Value" required="false"/>
            <property name="dashboardFilter" type="String" label="Dashboard Filter" required="false"/>
            <property name="lensFilter" type="String" label="Lens Filter" required="false"/>
            <property name="timeRange" type="String" label="Time Range" required="false"/>
            <property name="groupBy" type="String" label="Group By" required="false"/>
            <property name="aggregation" type="String" label="Aggregation" required="false"/>
            <property name="datasetName" type="String" label="Dataset Name" required="false"/>
            <property name="recordIdField" type="String" label="Record ID Field" required="false"/>
            <property name="datasetFilter" type="String" label="Dataset Filter" required="false"/>
        </targetConfig>
    </targetConfigs>
    <analytics>
        <filterAttributes>
            <filterAttribute name="dashboardFilter" type="String" label="Dashboard Filter"/>
            <filterAttribute name="lensFilter" type="String" label="Lens Filter"/>
            <filterAttribute name="timeRange" type="String" label="Time Range"/>
            <filterAttribute name="datasetFilter" type="String" label="Dataset Filter"/>
        </filterAttributes>
        <groupByAttributes>
            <groupByAttribute name="groupBy" type="String" label="Group By"/>
        </groupByAttributes>
        <aggregationAttributes>
            <aggregationAttribute name="aggregation" type="String" label="Aggregation"/>
        </aggregationAttributes>
        <datasetAttributes>
            <datasetAttribute name="datasetName" type="String" label="Dataset Name"/>
            <datasetAttribute name="recordIdField" type="String" label="Record ID Field"/>
        </datasetAttributes>
    </analytics>
</LightningComponentBundle> 